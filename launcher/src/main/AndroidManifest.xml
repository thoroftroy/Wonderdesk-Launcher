<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="dev.wonderdesk.memories.CONTROL" />
    <uses-permission android:name="dev.wonderdesk.ripple.QUICK" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Needed for the Uninstall action (Android asks the user to confirm every time). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <queries><package android:name="dev.wonderdesk.beacon" /><intent><action android:name="org.adw.launcher.THEMES" /></intent><intent><action android:name="com.novalauncher.THEME" /></intent><intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent><intent><action android:name="com.gau.go.launcherex.theme" /></intent><intent><action android:name="org.adw.ActivityStarter.THEMES" /></intent></queries>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <application android:enableOnBackInvokedCallback="true" android:label="Wonderdesk" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" tools:replace="android:icon,android:roundIcon">
        <activity android:name=".MainActivity" android:theme="@style/WonderdeskLauncherTheme" android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true"
            android:resizeableActivity="true" android:clearTaskOnLaunch="true" android:excludeFromRecents="true" android:windowSoftInputMode="adjustPan"
            android:screenOrientation="unspecified" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/launcher_shortcuts" />
        </activity>
        <provider android:name=".AppsProvider" android:authorities="dev.wonderdesk.launcher.apps" android:exported="true" />
        <receiver android:name=".AssistCardReceiver" android:exported="true"><intent-filter><action android:name="dev.wonderdesk.assist.CARD" /><action android:name="dev.wonderdesk.assist.CLEAR" /></intent-filter></receiver>
        <service android:name=".AssistTile" android:exported="true" android:label="Floating button" android:icon="@drawable/ic_tile_assist" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <activity android:name=".AssistToggleActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:taskAffinity="" />
        <service android:name=".LockService" android:exported="true" android:label="Wonderdesk shortcuts (lock and floating button)" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/lock_service" />
        </service>
        <activity android:name=".PinActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:taskAffinity="" android:autoRemoveFromRecents="true">
            <intent-filter><action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" /></intent-filter>
        </activity>
        <service android:name=".WonderdeskWallpaper" android:exported="true" android:label="Wonderdesk Aqua" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wonderdesk_wallpaper" />
        </service>
        <receiver android:name=".DayNightReceiver" android:exported="false"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.TIME_SET" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /></intent-filter></receiver>
    </application>
</manifest>
